# Guest kernel configuration for QEMU's x86_64 machine.
# Same display stack as the arm64 guest (bochs DRM on a stdvga), same input
# devices (virtio keyboard/tablet), same zram/serial setup, so the benchmark
# in docs/BENCHMARKS.md compares the CPU emulation, not the device models.
# CONFIG_DEBUG_INFO=n
CONFIG_DRM=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_KMS_FB_HELPER=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_INPUT_EVDEV=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_SWAP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EXT4_FS=y
CONFIG_9P_FS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
